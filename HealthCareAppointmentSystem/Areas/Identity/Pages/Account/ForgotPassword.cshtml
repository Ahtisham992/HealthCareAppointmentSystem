@page
@model HealthCareAppointmentSystem.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center">
    <div class="col-md-6" style="margin: 0 auto;">
        <form method="post" class="form-card text-center" style="max-width: 450px;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--primary);"><i class="fa-solid fa-key"></i></div>
            <h2 style="color: var(--primary); font-weight: 800; letter-spacing: -0.5px;">@ViewData["Title"]</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">Enter your email and we'll send you a link to reset your password.</p>
            
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>
            
            <div class="form-group" style="text-align: left;">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div>
                <button type="submit" class="btn btn-primary w-100" style="padding: 0.9rem; font-size: 1.1rem;">Reset Password</button>
            </div>
            
            <div style="margin-top: 1.5rem; font-size: 0.9rem;">
                <a asp-page="./Login" style="color: var(--text-muted); text-decoration: underline;">Back to Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
