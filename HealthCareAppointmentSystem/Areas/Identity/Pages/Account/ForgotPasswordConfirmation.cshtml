@page
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6" style="margin: 0 auto;">
        <div class="form-card text-center" style="max-width: 450px;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--success);"><i class="fa-regular fa-circle-check"></i></div>
            <h2 style="color: var(--primary); font-weight: 800; letter-spacing: -0.5px;">@ViewData["Title"]</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">
                Please check your email to reset your password.
            </p>
            <div style="margin-top: 1.5rem; font-size: 0.9rem;">
                <a asp-page="./Login" style="color: var(--text-muted); text-decoration: underline;">Back to Login</a>
            </div>
        </div>
    </div>
</div>
