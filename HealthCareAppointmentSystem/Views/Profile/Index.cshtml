@using HealthCareAppointmentSystem.ViewModels
@model ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h1>My Profile</h1>
    <a class="btn btn-primary" asp-action="Edit">Edit Profile</a>
</div>

<div class="detail-card">
    <dl>
        <dt>Full Name</dt>
        <dd>@Model.FullName</dd>
        
        <dt>Email</dt>
        <dd>@Model.Email</dd>
        
        <dt>Role</dt>
        <dd>@Model.Role</dd>

        @if (Model.Role == "Patient")
        {
            <hr />
            <dt>Date of Birth</dt>
            <dd>@(Model.DateOfBirth?.ToString("d") ?? "-")</dd>
            
            <dt>Phone Number</dt>
            <dd>@(Model.PhoneNumber ?? "-")</dd>
            
            <dt>Address</dt>
            <dd>@(Model.Address ?? "-")</dd>
        }
        else if (Model.Role == "Doctor")
        {
            <hr />
            <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 2rem;">
                <div style="flex-shrink: 0; text-align: center;">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid var(--primary); box-shadow: var(--shadow-sm);" />
                    }
                    else
                    {
                        <div style="width: 150px; height: 150px; border-radius: 50%; background-color: var(--bg-color); border: 3px solid var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--text-muted);">
                            👨‍⚕️
                        </div>
                    }
                </div>
                <div style="flex: 1;">
                    <h3 style="margin-top: 0; color: var(--primary);">Dr. @Model.FullName</h3>
                    <p style="font-size: 1.1rem; color: var(--secondary); font-weight: 600;">@(Model.SpecializationName ?? "Specialization Not Set")</p>
                    <p style="margin-bottom: 0.5rem;">
                        @if (Model.IsApproved)
                        {
                            <span class="status-badge status-completed">Verified & Approved</span>
                        }
                        else
                        {
                            <span class="status-badge status-pending">Pending Approval</span>
                        }
                    </p>
                </div>
            </div>

            <dt>Education & Qualifications</dt>
            <dd style="white-space: pre-wrap;">@(Model.Education ?? "Not provided yet")</dd>
            
            <dt>License Number</dt>
            <dd>@(Model.LicenseNumber ?? "-")</dd>
            
            <dt>Years of Experience</dt>
            <dd>@Model.YearsOfExperience</dd>
            
            <dt>Consultation Fee</dt>
            <dd>Rs. @Model.ConsultationFee?.ToString("N0")</dd>
            
            <hr />
            <dt>Available From</dt>
            <dd>@(Model.AvailableFrom?.ToString(@"hh\:mm") ?? "-")</dd>
            
            <dt>Available To</dt>
            <dd>@(Model.AvailableTo?.ToString(@"hh\:mm") ?? "-")</dd>
            
            <dt>Slot Duration</dt>
            <dd>@(Model.SlotDurationMinutes ?? 20) Mins</dd>
        }
    </dl>
</div>
