@using HealthCareAppointmentSystem.ViewModels
@model ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h1>My Profile</h1>
    <a class="btn btn-primary" asp-action="Edit">Edit Profile</a>
</div>

<div class="detail-card">
    <dl>
        <dt>Full Name</dt>
        <dd>@Model.FullName</dd>
        
        <dt>Email</dt>
        <dd>@Model.Email</dd>
        
        <dt>Role</dt>
        <dd>@Model.Role</dd>

        @if (Model.Role == "Patient")
        {
            <hr />
            <dt>Date of Birth</dt>
            <dd>@(Model.DateOfBirth?.ToString("d") ?? "-")</dd>
            
            <dt>Phone Number</dt>
            <dd>@(Model.PhoneNumber ?? "-")</dd>
            
            <dt>Address</dt>
            <dd>@(Model.Address ?? "-")</dd>
        }
        else if (Model.Role == "Doctor")
        {
            <hr />
            <dt>Status</dt>
            <dd>
                @if (Model.IsApproved)
                {
                    <span class="status-badge status-completed">Approved</span>
                }
                else
                {
                    <span class="status-badge status-pending">Pending Approval</span>
                }
            </dd>

            <dt>Specialization</dt>
            <dd>@(Model.SpecializationName ?? "-")</dd>
            
            <dt>License Number</dt>
            <dd>@(Model.LicenseNumber ?? "-")</dd>
            
            <dt>Years of Experience</dt>
            <dd>@Model.YearsOfExperience</dd>
            
            <dt>Consultation Fee</dt>
            <dd>Rs. @Model.ConsultationFee?.ToString("N0")</dd>
            
            <hr />
            <dt>Available From</dt>
            <dd>@(Model.AvailableFrom?.ToString(@"hh\:mm") ?? "-")</dd>
            
            <dt>Available To</dt>
            <dd>@(Model.AvailableTo?.ToString(@"hh\:mm") ?? "-")</dd>
            
            <dt>Slot Duration</dt>
            <dd>@(Model.SlotDurationMinutes ?? 20) Mins</dd>
        }
    </dl>
</div>
