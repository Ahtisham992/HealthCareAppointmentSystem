@model HealthCareAppointmentSystem.ViewModels.PatientEditViewModel

@{
    ViewData["Title"] = "Edit Patient";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="margin: 0;">Edit Patient Profile</h1>
    <p style="color: var(--text-muted); margin: 0.5rem 0 0 0;">Update patient details.</p>
</div>

<div class="form-card" style="max-width: 600px; margin: 0;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem; color: var(--danger);"></div>
        
        <div class="form-group">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-group">
            <label asp-for="CNIC"></label>
            <input asp-for="CNIC" class="form-control" placeholder="XXXXX-XXXXXXX-X" />
            <span asp-validation-for="CNIC" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-group" style="display: flex; gap: 1rem;">
            <div style="flex: 1;">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger" style="color: var(--danger);"></span>
            </div>
            <div style="flex: 1;">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger" style="color: var(--danger);"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Address"></label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-actions" style="margin-top:2rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary" style="flex: 1;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
