@model IEnumerable<Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 style="margin: 0;">Patients</h1>
    <form asp-action="Index" method="get" class="search-form" style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search patients..." style="max-width: 250px; margin-bottom: 0;" />
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Clear</a>
    </form>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background-color: var(--danger); color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span style="color: var(--secondary); font-family: monospace;">#PAT-@item.Id.ToString("D4")</span></td>
                <td>@item.ApplicationUser?.FullName</td>
                <td>@(item.PhoneNumber ?? "-")</td>
                <td>@(item.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</td>
                <td class="actions" style="display: flex; gap: 0.5rem; align-items: center;">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to permanently delete this patient profile?');">
                        <button type="submit" class="btn btn-danger btn-sm" style="background-color: var(--danger); border-color: var(--danger);">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="empty-state">No patients registered yet.</p>
}
