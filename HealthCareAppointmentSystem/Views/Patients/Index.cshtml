@model IEnumerable<Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    <h1 style="margin: 0;">Patients</h1>
    <a asp-action="Create" class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Add Patient
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background-color: var(--danger); color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<table id="patientsTable" class="data-table display" style="width:100%; margin-top:1rem;">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>CNIC</th>
            <th>Phone</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span style="color: var(--secondary); font-family: monospace;">#PAT-@item.Id.ToString("D4")</span></td>
                <td>@item.ApplicationUser?.FullName</td>
                <td>@item.CNIC</td>
                <td>@(item.PhoneNumber ?? "-")</td>
                <td>@(item.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</td>
                <td style="display:flex; gap:0.5rem;">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-primary">EDIT</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-secondary">DETAILS</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to permanently delete this patient profile?');">
                        <button type="submit" class="btn-action btn-action-danger">DELETE</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="empty-state">No patients registered yet.</p>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#patientsTable').DataTable({
                "pageLength": 10,
                "ordering": true,
                "responsive": true,
                "language": {
                    "search": "Filter:"
                }
            });
        });
    </script>
}
