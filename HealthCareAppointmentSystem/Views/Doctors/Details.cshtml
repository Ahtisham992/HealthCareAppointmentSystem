@model Doctor
@{
    ViewData["Title"] = "Doctor Details";
    var reviews = ViewBag.Reviews as List<HealthCareAppointmentSystem.Models.Review> ?? new List<HealthCareAppointmentSystem.Models.Review>();
    double averageRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
}

<div class="page-header">
    <h1>Doctor Profile</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <a asp-controller="Dashboard" asp-action="PatientDashboard" class="btn btn-secondary">Back to Search</a>
    }
</div>

<div class="detail-card">
    <div style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 2rem;">
        <div style="flex-shrink: 0; text-align: center;">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid var(--primary); box-shadow: var(--shadow-sm);" />
            }
            else
            {
                <div style="width: 150px; height: 150px; border-radius: 50%; background-color: var(--bg-color); border: 3px solid var(--border-color); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--text-muted);">
                    👨‍⚕️
                </div>
            }
        </div>
        <div style="flex: 1;">
            <h3 style="margin-top: 0; color: var(--primary);">Dr. @Model.ApplicationUser?.FullName</h3>
            <p style="font-size: 1.1rem; color: var(--secondary); font-weight: 600;">@(Model.Specialization?.Name ?? "Specialization Not Set")</p>
            <div class="profile-meta" style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <span>⭐ @(averageRating > 0 ? averageRating.ToString("0.0") : "No ratings yet") (@reviews.Count reviews)</span>
                <span>📅 @Model.YearsOfExperience Years Experience</span>
                <span>💰 Rs. @Model.ConsultationFee.ToString("N0")</span>
                <span>⏰ @Model.AvailableFrom.ToString(@"hh\:mm") - @Model.AvailableTo.ToString(@"hh\:mm")</span>
            </div>
            @if (User.IsInRole("Patient"))
            {
                <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Book Appointment</a>
            }
        </div>
    </div>

    <dl>
        <hr />
        <dt>Education & Qualifications</dt>
        <dd style="white-space: pre-wrap;">@(Model.Education ?? "Information not provided.")</dd>
        
        @if (User.IsInRole("Admin"))
        {
            <hr />
            <dt>License Number</dt>
            <dd>@Model.LicenseNumber</dd>

            <dt>Total Appointments</dt>
            <dd>@Model.Appointments.Count</dd>
        }
    </dl>
    
    <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <h4 style="margin-bottom: 1rem; color: var(--text);">Patient Reviews</h4>
        @if (reviews.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                @foreach (var review in reviews)
                {
                    <div style="background-color: var(--bg-color); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <strong>@review.Patient?.ApplicationUser?.FullName</strong>
                            <span style="color: #f39c12;">@(new string('⭐', review.Rating))</span>
                        </div>
                        <div style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">@review.CreatedAt.ToString("dd MMM yyyy")</div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p style="margin: 0;">@review.Comment</p>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No reviews yet.</p>
        }
    </div>
</div>
