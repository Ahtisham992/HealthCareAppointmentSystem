@model IEnumerable<Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <h1 style="margin: 0;">Doctors</h1>
        <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus" style="margin-right: 5px;"></i>Add Doctor</a>
    </div>
</div>

<table id="doctorsTable" class="data-table display" style="width:100%; margin-top:1rem;">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Specialization</th>
            <th>License #</th>
            <th>Experience</th>
            <th>Fee</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span style="color: var(--secondary); font-family: monospace;">#DOC-@item.Id.ToString("D4")</span></td>
                <td>Dr. @item.ApplicationUser?.FullName</td>
                <td>@item.Specialization?.Name</td>
                <td>@item.LicenseNumber</td>
                <td>@item.YearsOfExperience yrs</td>
                <td>Rs. @item.ConsultationFee.ToString("N0")</td>
                <td>
                    @if (item.IsApproved)
                    {
                        <span class="status-badge status-completed">Approved</span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">Pending</span>
                    }
                </td>
                <td class="actions" style="display: flex; gap: 0.5rem; align-items: center;">
                    @if (!item.IsApproved)
                    {
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-action btn-action-success">APPROVE</button>
                        </form>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-secondary">DETAILS</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-primary">EDIT</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to permanently delete this doctor profile?');">
                        <button type="submit" class="btn-action btn-action-danger">DELETE</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#doctorsTable').DataTable({
                "pageLength": 10,
                "ordering": true,
                "responsive": true,
                "language": {
                    "search": "Filter:"
                }
            });
        });
    </script>
}
