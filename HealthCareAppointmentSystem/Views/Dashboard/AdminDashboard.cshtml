@using HealthCareAppointmentSystem.ViewModels
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h1>Admin Dashboard</h1>
</div>

<div class="feature-grid" style="margin-bottom: 2rem;">
    <div class="feature-card text-center">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">👨‍⚕️</div>
        <h2 style="margin: 0; color: var(--primary);">@Model.TotalDoctors</h2>
        <p>Total Doctors</p>
    </div>
    
    <div class="feature-card text-center">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">👥</div>
        <h2 style="margin: 0; color: var(--primary);">@Model.TotalPatients</h2>
        <p>Total Patients</p>
    </div>
    
    <div class="feature-card text-center">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
        <h2 style="margin: 0; color: var(--danger);">@Model.PendingApprovals</h2>
        <p>Pending Approvals</p>
    </div>
    
    <div class="feature-card text-center">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">📅</div>
        <h2 style="margin: 0; color: var(--success);">@Model.TotalAppointments</h2>
        <p>Total Appointments</p>
    </div>
</div>

<div style="display: flex; gap: 1rem;">
    <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">Manage Doctors</a>
    <a asp-controller="Patients" asp-action="Index" class="btn btn-secondary">Manage Patients</a>
    <a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary">All Appointments</a>
</div>
