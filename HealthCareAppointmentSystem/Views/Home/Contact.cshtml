@{
    ViewData["Title"] = "Contact Us";
}

<div class="page-header text-center">
    <h1>Contact Us</h1>
    <p class="text-muted">We'd love to hear from you. Get in touch with our support team.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6" style="margin: 0 auto;">
        <div class="form-card">
            <div class="form-group">
                <label>Name</label>
                <input class="form-control" placeholder="John Doe" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input class="form-control" placeholder="john@example.com" />
            </div>
            <div class="form-group">
                <label>Message</label>
                <textarea class="form-control" rows="5" placeholder="How can we help you?"></textarea>
            </div>
            <button class="btn btn-primary w-100" style="padding: 1rem;">Send Message</button>
            <div style="margin-top: 2rem; text-align: center; color: var(--text-muted);">
                <p><i class="fa-solid fa-envelope"></i> support@healthcare.com</p>
                <p><i class="fa-solid fa-phone"></i> +1 (555) 123-4567</p>
            </div>
        </div>
    </div>
</div>
