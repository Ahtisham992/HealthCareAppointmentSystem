@model IEnumerable<HealthCareAppointmentSystem.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    var users = ViewBag.Users as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="page-header">
    <h1>System Audit Logs</h1>
</div>

<div class="detail-card" style="padding: 0;">
    <div style="max-height: 600px; overflow-y: auto; border-radius: 8px;">
        <table class="data-table" style="margin: 0;">
            <thead style="position: sticky; top: 0; background-color: var(--bg-color); z-index: 1;">
                <tr>
                    <th>Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="white-space: nowrap;">@log.Timestamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                        <td>@(users.ContainsKey(log.UserId) ? users[log.UserId] : log.UserId)</td>
                        <td><span style="font-weight: 600; color: var(--primary);">@log.Action</span></td>
                        <td style="color: var(--secondary);">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
