@model IEnumerable<HealthCareAppointmentSystem.Models.WithdrawalRequest>
@{
    ViewData["Title"] = "Accountant Dashboard";
    var platformBalance = ViewBag.PlatformBalance as decimal? ?? 0m;
    var completedRequests = ViewBag.CompletedRequests as IEnumerable<HealthCareAppointmentSystem.Models.WithdrawalRequest>;
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="h3 mb-3 text-gray-800">Accountant Dashboard</h1>
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                Platform Escrow Balance
                <div class="text-white-50 small">Current Total Funds Held</div>
                <div class="h2 mb-0 font-weight-bold">Rs. @platformBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Pending Withdrawal Requests</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Amount</th>
                        <th>Bank Details</th>
                        <th>Requested At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No pending withdrawal requests.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.Wallet?.ApplicationUser?.FullName (@req.Wallet?.ApplicationUser?.Email)</td>
                                <td class="text-danger font-weight-bold">Rs. @req.Amount.ToString("N2")</td>
                                <td><pre style="margin: 0; background: #f8f9fa; padding: 5px;">@req.BankDetails</pre></td>
                                <td>@req.RequestedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <form asp-action="ProcessWithdrawal" method="post" style="display:inline-flex; gap: 5px;">
                                        <input type="hidden" name="id" value="@req.Id" />
                                        <input type="text" name="notes" placeholder="Notes (Optional)" class="form-control form-control-sm" style="width: 150px;" />
                                        <button type="submit" name="action" value="Approve" class="btn btn-sm btn-success" onclick="return confirm('Confirm wire transfer sent?');">Approve</button>
                                        <button type="submit" name="action" value="Reject" class="btn btn-sm btn-danger" onclick="return confirm('Reject request and refund wallet?');">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (completedRequests != null && completedRequests.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-secondary">Recent Processed Requests</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm text-muted">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Processed At</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in completedRequests)
                        {
                            <tr>
                                <td>@req.Wallet?.ApplicationUser?.FullName</td>
                                <td>Rs. @req.Amount.ToString("N2")</td>
                                <td>
                                    @if (req.Status == HealthCareAppointmentSystem.Models.WithdrawalStatus.Completed)
                                    {
                                        <span class="badge bg-success text-white">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white">Rejected</span>
                                    }
                                </td>
                                <td>@req.ProcessedAt?.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@req.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
