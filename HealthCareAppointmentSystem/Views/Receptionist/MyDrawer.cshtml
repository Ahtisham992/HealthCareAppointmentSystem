@model HealthCareAppointmentSystem.ViewModels.MyDrawerViewModel
@{
    ViewData["Title"] = "My Cash Drawer";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1>My Cash Drawer</h1>
    <p>Manage the cash you have collected and hand it over directly to doctors.</p>
</div>

<div class="dashboard-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-bottom: 2rem; gap: 1rem;">
    <div class="stat-card" style="background: var(--surface); padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-left: 5px solid var(--success);">
        <div class="stat-details">
            <h3 style="margin: 0; font-size: 2.5rem; color: var(--primary);">Rs. @Model.TotalDrawerBalance.ToString("N0")</h3>
            <p style="margin: 0; color: var(--text-muted);">Total Cash in Drawer</p>
        </div>
    </div>
</div>

<div class="card" style="background: var(--surface); border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden; margin-bottom: 2rem;">
    <div class="card-header" style="padding: 1.5rem; border-bottom: 1px solid var(--border-color);">
        <h2 style="margin: 0; font-size: 1.25rem;">Doctor Cash Handovers</h2>
    </div>
    <div class="card-body" style="padding: 0;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <thead style="background: var(--bg-color);">
                <tr>
                    <th style="padding: 1rem; text-align: left;">Doctor</th>
                    <th style="padding: 1rem; text-align: left;">Total Collected</th>
                    <th style="padding: 1rem; text-align: center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.DoctorGroups.Any())
                {
                    <tr>
                        <td colspan="3" style="padding: 2rem; text-align: center; color: var(--text-muted);">No pending cash to hand over.</td>
                    </tr>
                }
                else
                {
                    foreach (var group in Model.DoctorGroups)
                    {
                        <tr style="border-top: 1px solid var(--border-color);">
                            <td style="padding: 1rem;">@group.DoctorName</td>
                            <td style="padding: 1rem; font-weight: bold; color: var(--success);">
                                Rs. @group.TotalCollected.ToString("N0")
                            </td>
                            <td style="padding: 1rem; text-align: center;">
                                <form method="post" asp-action="HandoverCashToDoctor" style="display: inline;">
                                    <input type="hidden" name="doctorId" value="@group.DoctorId" />
                                    <button type="submit" class="btn btn-sm btn-primary" onclick="return confirm('Are you sure you want to hand over Rs. @group.TotalCollected.ToString("N0") to @group.DoctorName?');">
                                        Handover to Doctor
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
