@model HealthCareAppointmentSystem.ViewModels.ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="margin: 0;">Receptionist Dashboard</h1>
    <p style="color: var(--text-muted); margin: 0.5rem 0 0 0;">Manage today's appointments and collect payments.</p>
</div>

<div class="dashboard-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="stat-card" style="background: var(--surface); padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h3 style="margin-top: 0; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">Cash Drawer</h3>
        <p style="font-size: 2rem; margin: 0; font-weight: bold; color: var(--primary);">Rs. @Model.CashDrawerBalance.ToString("N0")</p>
    </div>
    <div class="stat-card" style="background: var(--surface); padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h3 style="margin-top: 0; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">Pending Invoices</h3>
        <p style="font-size: 2rem; margin: 0; font-weight: bold; color: var(--warning);">@Model.PendingInvoicesCount</p>
    </div>
    <div class="stat-card" style="background: var(--surface); padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h3 style="margin-top: 0; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">Today's Appointments</h3>
        <p style="font-size: 2rem; margin: 0; font-weight: bold; color: var(--success);">@Model.TodayAppointmentsCount</p>
    </div>
</div>

<div class="actions" style="margin-bottom: 2rem; display: flex; gap: 1rem;">
    <a asp-action="BookAppointment" class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Book Appointment
    </a>
</div>

<h2>Today's Appointments & Payments</h2>
<div class="table-responsive" style="background: var(--surface); border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden;">
    <table class="table" style="width: 100%; border-collapse: collapse;">
        <thead style="background: var(--bg-color);">
            <tr>
                <th style="padding: 1rem; text-align: left;">Time</th>
                <th style="padding: 1rem; text-align: left;">Patient</th>
                <th style="padding: 1rem; text-align: left;">Doctor</th>
                <th style="padding: 1rem; text-align: left;">Fee</th>
                <th style="padding: 1rem; text-align: center;">Status</th>
                <th style="padding: 1rem; text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var apt in Model.UpcomingAppointments)
            {
                <tr style="border-top: 1px solid var(--border-color);">
                    <td style="padding: 1rem;">@apt.AppointmentDateTime.ToString("hh:mm tt")</td>
                    <td style="padding: 1rem;">@apt.Patient?.ApplicationUser?.FullName</td>
                    <td style="padding: 1rem;">Dr. @apt.Doctor?.ApplicationUser?.FullName</td>
                    <td style="padding: 1rem;">Rs. @apt.Invoice?.Amount.ToString("N0")</td>
                    <td style="padding: 1rem; text-align: center;">
                        @if (apt.Invoice?.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Paid)
                        {
                            <span style="background: rgba(40, 167, 69, 0.1); color: var(--success); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500;">Paid</span>
                        }
                        else
                        {
                            <span style="background: rgba(255, 193, 7, 0.1); color: var(--warning); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500;">Pending</span>
                        }
                    </td>
                    <td style="padding: 1rem; text-align: center;">
                        @if (apt.Invoice?.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Pending)
                        {
                            <form asp-controller="Invoices" asp-action="CollectCashPayment" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@apt.Invoice.Id" />
                                <button type="submit" class="btn-action btn-action-success" title="Collect Cash" onclick="return confirm('Confirm cash collection?');">
                                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span style="color: var(--text-muted); font-size: 0.85rem;">Completed</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.UpcomingAppointments.Any())
            {
                <tr>
                    <td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-muted);">No appointments today.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
