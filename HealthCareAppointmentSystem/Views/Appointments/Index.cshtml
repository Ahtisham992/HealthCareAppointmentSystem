@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <h1 style="margin: 0;">Appointments</h1>
        @if (User.IsInRole("Patient") || User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-action="Create">+ Book Appointment</a>
        }
    </div>
    <form asp-action="Index" method="get" class="search-form" style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search..." style="max-width: 250px; margin-bottom: 0;" />
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Clear</a>
    </form>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Date &amp; Time</th>
            <th>Doctor</th>
            <th>Patient</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="white-space: nowrap;"><span style="color: var(--secondary); font-family: monospace; font-weight: 600;">#APT-@item.Id.ToString("D4")</span></td>
                <td style="white-space: nowrap; font-size: 0.9rem;">@item.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                <td>Dr. @item.Doctor?.ApplicationUser?.FullName</td>
                <td>@item.Patient?.ApplicationUser?.FullName</td>
                <td>
                    @{
                        var isPast = item.AppointmentDateTime.AddMinutes(item.Doctor?.SlotDurationMinutes ?? 20) <= DateTime.Now;
                        var statusText = item.Status.ToString();
                        
                        if (item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.PatientCancellationRequested)
                        {
                            statusText = "Cancel Requested (Patient)";
                        }
                        else if (item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.DoctorCancellationRequested)
                        {
                            statusText = "Cancel Requested (Doctor)";
                        }
                        else if ((item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Pending || item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Confirmed) && isPast)
                        {
                            statusText = "Completed (Pending Review)";
                        }
                    }
                    <span class="status-badge status-@(item.Status.ToString().ToLower())" style="white-space: nowrap; @(statusText.Contains("Review") ? "background-color: #fef08a; color: #854d0e;" : "")">@statusText</span>
                </td>
                <td class="actions">
                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                        
                        @if (isPast && (item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Pending || item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Confirmed))
                        {
                            <form asp-action="MarkCompleted" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;">
                                <button type="submit" class="btn btn-primary btn-sm">Mark Completed</button>
                            </form>
                        }

                        @if (User.IsInRole("Patient") && item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Completed)
                        {
                            var reviewedIds = ViewBag.ReviewedAppointmentIds as List<int> ?? new List<int>();
                            if (reviewedIds.Contains(item.Id))
                            {
                                <button class="btn btn-secondary btn-sm" disabled style="background-color: #e2e8f0; color: #94a3b8; cursor: not-allowed; border:none;">Submitted Review</button>
                            }
                            else
                            {
                                <a asp-controller="Reviews" asp-action="Create" asp-route-appointmentId="@item.Id" class="btn btn-primary btn-sm" style="background-color: var(--success); border-color: var(--success);">Leave Review</a>
                            }
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        }
                        
                        @if ((User.IsInRole("Patient") || User.IsInRole("Doctor")) && (item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Pending || item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.Confirmed))
                        {
                            <form asp-action="RequestCancellation" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;" onsubmit="return confirm('Are you sure you want to request cancellation for this appointment?');">
                                <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">Request Cancel</button>
                            </form>
                        }

                        @if (User.IsInRole("Doctor") && item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.PatientCancellationRequested)
                        {
                            <form asp-action="ConfirmCancellation" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;" onsubmit="return confirm('Are you sure you want to confirm this cancellation request?');">
                                <button type="submit" class="btn btn-danger btn-sm" style="background-color: var(--danger);">Confirm Cancel</button>
                            </form>
                        }
                        else if (User.IsInRole("Patient") && item.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.DoctorCancellationRequested)
                        {
                            <form asp-action="ConfirmCancellation" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;" onsubmit="return confirm('Are you sure you want to confirm this cancellation request?');">
                                <button type="submit" class="btn btn-danger btn-sm" style="background-color: var(--danger);">Confirm Cancel</button>
                            </form>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;" onsubmit="return confirm('Are you sure you want to delete this appointment?');">
                                <button type="submit" class="btn btn-danger btn-sm" style="background-color: var(--danger); border-color: var(--danger);">Delete</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="empty-state">No appointments to show yet.</p>
}
