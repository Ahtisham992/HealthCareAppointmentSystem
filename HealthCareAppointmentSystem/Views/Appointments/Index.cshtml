@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <h1>Appointments</h1>
    @if (User.IsInRole("Patient") || User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Book Appointment</a>
    }
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>Date &amp; Time</th>
            <th>Doctor</th>
            <th>Patient</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                <td>Dr. @item.Doctor?.ApplicationUser?.FullName</td>
                <td>@item.Patient?.ApplicationUser?.FullName</td>
                <td><span class="status-badge status-@item.Status.ToString().ToLower()">@item.Status</span></td>
                <td class="actions" style="display: flex; gap: 0.5rem; align-items: center;">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                    
                    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                    }
                    else if (User.IsInRole("Patient") && (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Confirmed))
                    {
                        <form asp-action="RequestCancellation" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to request cancellation for this appointment?');">
                            <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">Request Cancel</button>
                        </form>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Patient"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger" style="margin-left: 0.5rem;">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="empty-state">No appointments to show yet.</p>
}
