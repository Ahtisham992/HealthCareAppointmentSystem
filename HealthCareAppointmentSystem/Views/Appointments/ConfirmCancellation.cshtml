@model HealthCareAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Confirm Cancellation";
}

<div class="page-header">
    <h1>Confirm Cancellation</h1>
</div>

<div class="auth-container" style="max-width: 600px; margin: 2rem auto;">
    <div class="auth-card">
        <h3>Confirm Cancellation Request</h3>
        
        <div style="background-color: var(--background); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem;">
            <p><strong>Appointment ID:</strong> #APT-@Model.Id.ToString("D4")</p>
            <p><strong>Date & Time:</strong> @Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</p>
            @if (Model.Invoice != null)
            {
                <p><strong>Payment Status:</strong> @Model.Invoice.Status</p>
            }
        </div>

        <form asp-action="ConfirmCancellation" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger" style="color: var(--danger); margin-bottom: 1rem;"></div>

            @if ((User.IsInRole("Doctor") || User.IsInRole("Admin")) && Model.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.PatientCancellationRequested)
            {
                if (Model.Invoice != null && Model.Invoice.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Paid)
                {
                    var refundAmt = Model.Invoice.Amount * 0.70m;
                    <div class="alert alert-warning" style="background-color: #fef08a; color: #854d0e; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                        <strong>Refund Required:</strong> The patient requested this cancellation. You must provide a 70% refund (<strong>@refundAmt.ToString("C")</strong>) to confirm the cancellation.
                    </div>

                    <div class="form-group">
                        <label class="control-label">Upload Refund Screenshot (70% Refund) <span style="color:var(--danger)">*</span></label>
                        <input type="file" name="refundScreenshot" class="form-control" accept="image/*" required />
                        <small class="form-text text-muted" style="color: var(--text-light); font-size: 0.85rem;">Please upload proof of the refund transaction.</small>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-light); margin-bottom: 1rem;">The patient requested this cancellation. No refund is required as the appointment has not been paid yet.</p>
                }
            }
            else if (User.IsInRole("Patient") && Model.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.DoctorCancellationRequested)
            {
                <p style="color: var(--text-light); margin-bottom: 1rem;">The doctor has requested to cancel this appointment. Please confirm to finalize the cancellation.</p>
                
                @if (Model.Invoice != null && !string.IsNullOrEmpty(Model.Invoice.RefundScreenshotUrl))
                {
                    <div style="margin-top: 1.5rem; margin-bottom: 1.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.5rem; background-color: var(--background);">
                        <h4 style="margin-top: 0;">Refund Proof</h4>
                        <p style="color: var(--text-light); font-size: 0.9rem;">The doctor has provided a 100% refund (<strong>@Model.Invoice.RefundAmount?.ToString("C")</strong>).</p>
                        <img src="@Model.Invoice.RefundScreenshotUrl" alt="Refund Proof" style="max-width: 100%; max-height: 400px; border-radius: 0.25rem; margin-top: 0.5rem;" />
                    </div>
                }
            }
            else if (User.IsInRole("Patient") && Model.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.PatientRefundVerificationPending)
            {
                <p style="color: var(--text-light); margin-bottom: 1rem;">The doctor has confirmed your cancellation request and issued a refund. Please verify the refund proof below to finalize the cancellation.</p>
                
                @if (Model.Invoice != null && !string.IsNullOrEmpty(Model.Invoice.RefundScreenshotUrl))
                {
                    <div style="margin-top: 1.5rem; margin-bottom: 1.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.5rem; background-color: var(--background);">
                        <h4 style="margin-top: 0;">Refund Proof</h4>
                        <p style="color: var(--text-light); font-size: 0.9rem;">The doctor has provided a 70% refund (<strong>@Model.Invoice.RefundAmount?.ToString("C")</strong>).</p>
                        <img src="@Model.Invoice.RefundScreenshotUrl" alt="Refund Proof" style="max-width: 100%; max-height: 400px; border-radius: 0.25rem; margin-top: 0.5rem;" />
                    </div>
                }
            }

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-danger" style="background-color: var(--danger);">@(Model.Status == HealthCareAppointmentSystem.Models.AppointmentStatus.PatientRefundVerificationPending ? "Verify Refund & Finalize" : "Confirm Cancellation")</button>
                <a asp-action="Index" class="btn btn-secondary">Go Back</a>
            </div>
        </form>
    </div>
</div>
