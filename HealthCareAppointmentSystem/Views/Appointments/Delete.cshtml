@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>
<p class="warning-text">Are you sure you want to delete this appointment? This action cannot be undone.</p>

<div class="detail-card">
    <dl>
        <dt>Doctor</dt>
        <dd>Dr. @Model.Doctor?.ApplicationUser?.FullName</dd>

        <dt>Patient</dt>
        <dd>@Model.Patient?.ApplicationUser?.FullName</dd>

        <dt>Date &amp; Time</dt>
        <dd>@Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</dd>

        <dt>Status</dt>
        <dd>@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
