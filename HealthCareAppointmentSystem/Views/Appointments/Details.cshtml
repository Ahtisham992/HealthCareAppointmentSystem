@model HealthCareAppointmentSystem.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 style="font-size: 2rem; font-weight: 800; color: var(--primary); margin-bottom: 0.5rem;">Appointment Details</h1>
        <p style="color: var(--text-muted);">View appointment history, diagnostics, and electronic health records.</p>
    </div>
</div>

<div class="row">
    <!-- Main Appointment Content -->
    <div class="col-md-8">
        <div class="form-card mb-4" style="max-width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0; color: var(--primary);">Consultation Overview</h3>
                <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
            </div>
            
            <dl class="row" style="margin-bottom: 0;">
                <dt class="col-sm-3 text-muted">Doctor</dt>
                <dd class="col-sm-9 font-weight-bold">Dr. @Model.Doctor?.ApplicationUser?.FullName</dd>

                <dt class="col-sm-3 text-muted">Patient</dt>
                <dd class="col-sm-9 font-weight-bold">@Model.Patient?.ApplicationUser?.FullName</dd>

                <dt class="col-sm-3 text-muted">Date</dt>
                <dd class="col-sm-9">@Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</dd>

                <dt class="col-sm-3 text-muted">Reason/Notes</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No special instructions provided." : Model.Notes)</dd>
            </dl>

            <div class="mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>

        <!-- Diagnostic Orders Section -->
        <div class="form-card mb-4" style="max-width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
                <h3 style="margin: 0; color: var(--primary);">Diagnostic Orders</h3>
            </div>

            @if (Model.LabOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table data-table table-hover">
                        <thead>
                            <tr>
                                <th>Test Type</th>
                                <th>Sample ID</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lo in Model.LabOrders)
                            {
                                <tr>
                                    <td>@lo.TestType</td>
                                    <td>@(string.IsNullOrEmpty(lo.SampleId) ? "N/A" : lo.SampleId)</td>
                                    <td>
                                        @if (lo.PaymentStatus == HealthCareAppointmentSystem.Models.PaymentStatus.Paid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (lo.PaymentStatus == HealthCareAppointmentSystem.Models.PaymentStatus.AwaitingVerification)
                                        {
                                            <span class="badge bg-info text-dark">Billed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pending Bill</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lo.IsCompleted)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lo.IsCompleted && lo.LabResult != null)
                                        {
                                            <a href="@lo.LabResult.FileUrl" target="_blank" class="btn-action btn-action-info">View Result PDF</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Awaiting Lab Tech</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No diagnostic tests have been ordered for this appointment.</p>
            }

            @if (User.IsInRole("Doctor") && Model.Status == AppointmentStatus.Confirmed)
            {
                <div class="mt-4 pt-3 border-top">
                    <h5 style="color: var(--primary);">Order New Test</h5>
                    <form asp-action="OrderLabTest" method="post" class="d-flex align-items-center gap-3">
                        <input type="hidden" name="appointmentId" value="@Model.Id" />
                        <input type="text" name="testType" class="form-control w-auto" placeholder="e.g. Complete Blood Count" required style="flex: 1;" />
                        <input type="text" name="notes" class="form-control w-auto" placeholder="Notes (Optional)" style="flex: 2;" />
                        <button type="submit" class="btn btn-primary">Order Test</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Patient EHR Sidebar -->
    <div class="col-md-4">
        <div class="form-card" style="background-color: #f8fafc; border-left: 4px solid var(--info); max-width: 100%;">
            <h4 style="color: var(--primary); margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
                <i class="fas fa-file-medical me-2"></i> Patient EHR
            </h4>

            @if (Model.Patient?.MedicalProfile != null)
            {
                <div class="mb-3">
                    <label class="text-muted small text-uppercase font-weight-bold d-block">Blood Group</label>
                    <div style="font-size: 1.25rem; font-weight: 800; color: var(--danger);">
                        @(Model.Patient.MedicalProfile.BloodGroup ?? "Unknown")
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase font-weight-bold d-block">Known Allergies</label>
                    <div style="font-size: 0.95rem; color: var(--text);">
                        @(string.IsNullOrEmpty(Model.Patient.MedicalProfile.KnownAllergies) ? "None recorded" : Model.Patient.MedicalProfile.KnownAllergies)
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase font-weight-bold d-block">Chronic Conditions</label>
                    <div style="font-size: 0.95rem; color: var(--text);">
                        @(string.IsNullOrEmpty(Model.Patient.MedicalProfile.ChronicConditions) ? "None recorded" : Model.Patient.MedicalProfile.ChronicConditions)
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">No medical profile established yet.</p>
            }
        </div>
    </div>
</div>
