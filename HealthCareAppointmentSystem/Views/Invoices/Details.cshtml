@model HealthCareAppointmentSystem.Models.Invoice

@{
    ViewData["Title"] = "Invoice Slip";
}

<style>
    .invoice-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        padding: 3rem;
        max-width: 800px;
        margin: 2rem auto;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--border);
    }
    .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-45deg);
        font-size: 8rem;
        font-weight: 900;
        color: rgba(200, 200, 200, 0.15);
        pointer-events: none;
        z-index: 0;
        white-space: nowrap;
    }
    .watermark.paid {
        color: rgba(34, 197, 94, 0.15); /* Greenish for paid */
    }
    .watermark.due {
        color: rgba(239, 68, 68, 0.15); /* Reddish for due */
    }
    
    .invoice-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 2px solid var(--border);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }
    .invoice-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--primary);
        margin: 0;
    }
    
    .invoice-details {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3rem;
        position: relative;
        z-index: 1;
    }
    .invoice-section h4 {
        font-size: 0.9rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }
    .invoice-section p {
        margin: 0.2rem 0;
        font-weight: 600;
        color: var(--text);
    }
    
    .invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }
    .invoice-table th, .invoice-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }
    .invoice-table th {
        background: #f8fafc;
        color: var(--text-muted);
        font-weight: 600;
    }
    .invoice-table td.amount {
        text-align: right;
        font-weight: 700;
        font-size: 1.2rem;
    }
    .invoice-table th.amount-head {
        text-align: right;
    }

    .invoice-footer {
        display: flex;
        justify-content: flex-end;
        position: relative;
        z-index: 1;
    }
    .total-box {
        background: #f8fafc;
        padding: 1.5rem 2rem;
        border-radius: 8px;
        text-align: right;
        border: 1px solid var(--border);
    }
    .total-box .label {
        color: var(--text-muted);
        font-weight: 600;
        font-size: 1.1rem;
        margin-right: 1rem;
    }
    .total-box .value {
        font-size: 2rem;
        font-weight: 800;
        color: var(--primary);
    }

    .action-buttons {
        text-align: center;
        margin-top: 2rem;
    }

    @@media print {
        header, footer, .action-buttons, .navbar { display: none !important; }
        body { background: white !important; }
        .invoice-card { box-shadow: none; border: none; margin: 0; padding: 0; }
        main.container { max-width: 100%; padding: 0; margin: 0; }
    }
</style>

<div class="invoice-card">
    @if (Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Paid)
    {
        <div class="watermark paid">PAID IN FULL</div>
    }
    else if (Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.AwaitingVerification)
    {
        <div class="watermark">VERIFYING</div>
    }
    else
    {
        <div class="watermark due">PAYMENT DUE</div>
    }

    <div class="invoice-header">
        <div>
            <h1 class="invoice-title">INVOICE</h1>
            <p style="color: var(--text-muted); margin-top: 0.5rem;">#INV-@Model.Id.ToString("D6")</p>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text);">HealthCare Plus</div>
            <p style="color: var(--text-muted); margin-top: 0.2rem;">123 Medical Boulevard<br/>Health City, HC 12345</p>
        </div>
    </div>

    <div class="invoice-details">
        <div class="invoice-section">
            <h4>Billed To</h4>
            <p>@Model.Appointment?.Patient?.ApplicationUser?.FullName</p>
            <p style="font-weight: normal; color: var(--text-muted);">Patient ID: @Model.Appointment?.PatientId</p>
        </div>
        <div class="invoice-section">
            <h4>Provider</h4>
            <p>@Model.Appointment?.Doctor?.ApplicationUser?.FullName</p>
            <p style="font-weight: normal; color: var(--text-muted);">@Model.Appointment?.Doctor?.Specialization?.Name</p>
        </div>
        <div class="invoice-section" style="text-align: right;">
            <h4>Invoice Date</h4>
            <p>@Model.IssuedAt.ToString("MMM dd, yyyy")</p>
            <h4 style="margin-top: 1rem;">Status</h4>
            <p>
                @if (Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Paid)
                {
                    <span style="color: #10b981;">● Paid on @Model.PaidAt?.ToString("MMM dd, yyyy")</span>
                }
                else if (Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.AwaitingVerification)
                {
                    <span style="color: #f59e0b;">● Awaiting Verification</span>
                }
                else
                {
                    <span style="color: #ef4444;">● Pending</span>
                }
            </p>
        </div>
    </div>

    <table class="invoice-table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Appt Date</th>
                <th class="amount-head">Amount</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <strong>Medical Consultation</strong><br/>
                    <span style="font-size: 0.85rem; color: var(--text-muted);">Appointment ID: @Model.AppointmentId</span>
                </td>
                <td>@Model.Appointment?.AppointmentDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                <td class="amount">PKR @Model.Amount.ToString("N2")</td>
            </tr>
        </tbody>
    </table>

    <div class="invoice-footer">
        <div class="total-box">
            <span class="label">Total Due:</span>
            <span class="value">PKR @Model.Amount.ToString("N2")</span>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.TransactionReference))
    {
        <div style="margin-top: 2rem; padding: 1rem; background: #f8fafc; border-radius: 8px; font-size: 0.9rem; position: relative; z-index: 1;">
            <strong>Payment Info:</strong> Paid via @Model.PaymentMethod (Ref: @Model.TransactionReference)
        </div>
    }
</div>

<div class="action-buttons">
    <button class="btn btn-secondary" onclick="window.print()" style="margin-right: 1rem;">
        <i class="fa-solid fa-print"></i> Print Slip
    </button>
    
    @if (User.IsInRole("Patient") && Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Pending)
    {
        <a asp-action="SubmitPayment" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fa-solid fa-credit-card"></i> Submit Payment Proof
        </a>
    }

    @if ((User.IsInRole("Admin") || User.IsInRole("Doctor")) && Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.AwaitingVerification)
    {
        <form asp-action="VerifyPayment" asp-route-id="@Model.Id" method="post" style="display: inline-block;">
            <button type="submit" class="btn btn-primary" style="background: #10b981; border-color: #10b981;">
                <i class="fa-solid fa-check-double"></i> Verify & Mark Paid
            </button>
        </form>
    }

    @if (User.IsInRole("Receptionist") && (Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.Pending || Model.Status == HealthCareAppointmentSystem.Models.PaymentStatus.AwaitingVerification))
    {
        <form asp-action="VerifyPayment" asp-route-id="@Model.Id" method="post" style="display: inline-block;">
            <button type="submit" class="btn btn-primary" style="background: #10b981; border-color: #10b981;" onclick="return confirm('Confirm you have received Rs. @Model.Amount.ToString("N0") cash?');">
                <i class="fa-solid fa-money-bill-wave"></i> Collect Cash & Mark Paid
            </button>
        </form>
    }
</div>
