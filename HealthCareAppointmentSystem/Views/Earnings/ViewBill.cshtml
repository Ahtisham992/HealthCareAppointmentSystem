@model HealthCareAppointmentSystem.Models.PlatformBill
@{
    ViewData["Title"] = "Platform Bill";
    var months = new[] {
        "January", "February", "March", "April", "May", "June", 
        "July", "August", "September", "October", "November", "December"
    };
    bool isPaid = Model.Status == HealthCareAppointmentSystem.Models.BillStatus.Paid;
}

<div class="container" style="max-width: 800px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <a asp-action="@(User.IsInRole("Admin") ? "AdminIndex" : "MyEarnings")" class="btn-action btn-action-secondary">BACK TO LIST</a>
        <button onclick="window.print()" class="btn-action btn-action-primary">PRINT BILL</button>
    </div>

    <div style="background: white; border-radius: 12px; padding: 3rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid var(--border);">
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--border); padding-bottom: 2rem; margin-bottom: 2rem;">
            <div>
                <h1 style="color: var(--primary); margin: 0; font-size: 2.5rem; letter-spacing: -1px;">PLATFORM INVOICE</h1>
                <p style="color: var(--text-muted); margin: 0.5rem 0 0 0; font-size: 1.1rem;">HealthCare Appointment System</p>
            </div>
            <div style="text-align: right;">
                <h3 style="margin: 0; color: var(--text-muted);">Invoice #@Model.Id.ToString("D5")</h3>
                <p style="margin: 0.5rem 0 0 0; font-weight: bold; font-size: 1.2rem;">@months[Model.Month - 1] @Model.Year</p>
            </div>
        </div>

        <!-- Details -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 3rem;">
            <div>
                <h4 style="color: var(--text-muted); margin: 0 0 0.5rem 0; text-transform: uppercase; font-size: 0.85rem;">Billed To</h4>
                <h3 style="margin: 0 0 0.25rem 0;">Dr. @Model.Doctor.ApplicationUser.FullName</h3>
                <p style="margin: 0; color: var(--text-muted);">License: @Model.Doctor.LicenseNumber</p>
                <p style="margin: 0; color: var(--text-muted);">@Model.Doctor.ApplicationUser.Email</p>
            </div>
            <div style="text-align: right;">
                <h4 style="color: var(--text-muted); margin: 0 0 0.5rem 0; text-transform: uppercase; font-size: 0.85rem;">Status</h4>
                @if (isPaid)
                {
                    <div style="color: var(--success); font-weight: 800; font-size: 1.5rem; letter-spacing: 1px;">PAID</div>
                    <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">On @Model.PaidAt?.ToString("dd MMM yyyy")</p>
                }
                else
                {
                    <div style="color: var(--danger); font-weight: 800; font-size: 1.5rem; letter-spacing: 1px;">DUE</div>
                }
            </div>
        </div>

        <!-- Break Down -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem;">
            <thead>
                <tr style="border-bottom: 2px solid var(--text); text-align: left;">
                    <th style="padding: 1rem 0; text-transform: uppercase; color: var(--text-muted); font-size: 0.85rem;">Description</th>
                    <th style="padding: 1rem 0; text-align: right; text-transform: uppercase; color: var(--text-muted); font-size: 0.85rem;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid var(--border);">
                    <td style="padding: 1.5rem 0; font-weight: 500;">Total Net Earnings for @months[Model.Month - 1] @Model.Year</td>
                    <td style="padding: 1.5rem 0; text-align: right;">Rs. @Model.TotalEarnings.ToString("N0")</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border);">
                    <td style="padding: 1.5rem 0; font-weight: 500;">Platform Commission (10%)</td>
                    <td style="padding: 1.5rem 0; text-align: right; color: var(--danger);">Rs. @Model.CommissionAmount.ToString("N0")</td>
                </tr>
            </tbody>
        </table>

        <!-- Totals -->
        <div style="display: flex; justify-content: flex-end; margin-top: 2rem;">
            <div style="width: 300px;">
                <div style="display: flex; justify-content: space-between; padding: 1rem 0; border-top: 2px solid var(--text);">
                    <span style="font-weight: 800; font-size: 1.2rem;">Total Due</span>
                    <span style="font-weight: 800; font-size: 1.5rem; color: var(--primary);">Rs. @Model.CommissionAmount.ToString("N0")</span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div style="margin-top: 4rem; text-align: center; color: var(--text-muted); font-size: 0.9rem; padding-top: 2rem; border-top: 1px solid var(--border);">
            <p>Please remit payment within 7 days of invoice generation to avoid account suspension.</p>
            <p style="margin-top: 0.5rem; font-weight: bold;">Thank you for your business!</p>
        </div>
    </div>
</div>

<style>
    @@media print {
        body { background: white; }
        .navbar, .footer, .btn-action { display: none !important; }
        .container { margin: 0 !important; padding: 0 !important; max-width: 100% !important; }
        .form-card, div[style*="box-shadow"] { box-shadow: none !important; border: none !important; padding: 0 !important; }
    }
</style>
