@model HealthCareAppointmentSystem.ViewModels.DoctorEarningsViewModel
@{
    ViewData["Title"] = "My Earnings Logs";
    var months = new[] {
        "January", "February", "March", "April", "May", "June", 
        "July", "August", "September", "October", "November", "December"
    };
    var bills = ViewBag.Bills as List<HealthCareAppointmentSystem.Models.PlatformBill>;
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="margin: 0;">My Earnings</h1>
    <p style="color: var(--text-muted); margin: 0.5rem 0 0 0;">View your income and deduction logs for the selected month.</p>
</div>

<div class="form-card" style="max-width: 100%; margin-bottom: 2rem;">
    <form method="get" asp-action="MyEarnings" style="display: flex; gap: 1rem; align-items: flex-end;">
        <div class="form-group" style="margin: 0; flex: 1;">
            <label for="month">Select Month</label>
            <select name="month" id="month" class="form-control">
                @for (int i = 1; i <= 12; i++)
                {
                    if (i == Model.Month)
                    {
                        <option value="@i" selected>@months[i - 1]</option>
                    }
                    else
                    {
                        <option value="@i">@months[i - 1]</option>
                    }
                }
            </select>
        </div>
        <div class="form-group" style="margin: 0; flex: 1;">
            <label for="year">Select Year</label>
            <select name="year" id="year" class="form-control">
                @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 1; i++)
                {
                    if (i == Model.Year)
                    {
                        <option value="@i" selected>@i</option>
                    }
                    else
                    {
                        <option value="@i">@i</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.5rem;">Filter</button>
    </form>
</div>

<div class="feature-grid" style="margin-bottom: 2rem; grid-template-columns: repeat(4, 1fr);">
    <div class="feature-card" style="padding: 1.5rem;">
        <h4 style="margin: 0 0 0.5rem 0; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;">Total Received</h4>
        <h2 style="margin: 0; color: var(--success);">Rs. @Model.TotalEarnedThisMonth.ToString("N0")</h2>
    </div>
    <div class="feature-card" style="padding: 1.5rem;">
        <h4 style="margin: 0 0 0.5rem 0; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;">Total Refunded</h4>
        <h2 style="margin: 0; color: var(--danger);">Rs. @Model.TotalRefundedThisMonth.ToString("N0")</h2>
    </div>
    <div class="feature-card" style="padding: 1.5rem;">
        <h4 style="margin: 0 0 0.5rem 0; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;">Platform Fees Paid</h4>
        <h2 style="margin: 0; color: #f59e0b;">Rs. @Model.TotalPlatformFeesPaid.ToString("N0")</h2>
    </div>
    <div class="feature-card" style="padding: 1.5rem; background: var(--primary);">
        <h4 style="margin: 0 0 0.5rem 0; color: rgba(255,255,255,0.8); font-size: 0.85rem; text-transform: uppercase;">Net Income</h4>
        <h2 style="margin: 0; color: white;">Rs. @Model.NetEarnedThisMonth.ToString("N0")</h2>
    </div>
</div>

<h3 style="margin-bottom: 1rem;">Transaction Logs</h3>
<div style="background: var(--card-bg); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow-x: auto; border: 1px solid var(--border); margin-bottom: 3rem;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Date & Time</th>
                <th>Type</th>
                <th>Description</th>
                <th style="text-align: right;">Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Logs.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center" style="padding: 3rem; color: var(--text-muted);">No transactions found for this month.</td>
                </tr>
            }
            else
            {
                foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>@log.Date.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td><span class="status-badge @log.BadgeClass">@log.Type</span></td>
                        <td>@log.Description</td>
                        <td style="text-align: right; font-weight: bold; color: @(log.Type == "Payment" ? "var(--success)" : "var(--danger)");">
                            @(log.Type == "Payment" ? "+" : "-")Rs. @log.Amount.ToString("N0")
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (bills != null && bills.Count > 0)
{
    <h3 style="margin-bottom: 1rem;">Platform Billing History</h3>
    <div style="background: var(--card-bg); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow-x: auto; border: 1px solid var(--border);">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Billing Month</th>
                    <th>Generated On</th>
                    <th>Net Earnings</th>
                    <th>Platform Fee (10%)</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in bills)
                {
                    <tr>
                        <td style="font-weight: 600;">@months[bill.Month - 1] @bill.Year</td>
                        <td>@bill.GeneratedAt.ToString("dd MMM yyyy")</td>
                        <td>Rs. @bill.TotalEarnings.ToString("N0")</td>
                        <td style="color: var(--danger); font-weight: bold;">Rs. @bill.CommissionAmount.ToString("N0")</td>
                        <td>
                            @if (bill.Status == HealthCareAppointmentSystem.Models.BillStatus.Paid)
                            {
                                <span class="status-badge status-completed">VERIFIED & PAID</span>
                            }
                            else if (bill.Status == HealthCareAppointmentSystem.Models.BillStatus.PaymentSubmitted)
                            {
                                <span class="status-badge status-pending" style="background-color: #fef3c7; color: #d97706;">PAYMENT SUBMITTED</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending" style="background-color: #fee2e2; color: #dc2626;">PENDING PAYMENT</span>
                            }
                        </td>
                        <td style="display: flex; gap: 0.5rem; align-items: center;">
                            <a asp-action="ViewBill" asp-route-id="@bill.Id" class="btn-action btn-action-secondary">VIEW SLIP</a>
                            
                            @if (bill.Status == HealthCareAppointmentSystem.Models.BillStatus.Pending)
                            {
                                <button type="button" class="btn-action btn-action-primary" onclick="openPaymentModal(@bill.Id, @bill.CommissionAmount, '@months[bill.Month - 1] @bill.Year')">PAY BILL</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Payment Modal -->
<div id="paymentModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 12px; width: 100%; max-width: 500px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        <div style="padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; color: var(--text-dark);">Submit Platform Fee Payment</h3>
            <button type="button" onclick="closePaymentModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
        </div>
        <div style="padding: 1.5rem;">
            <div style="background: #f1f5f9; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                <p style="margin: 0 0 0.5rem 0; font-size: 0.9rem; color: var(--text-muted);">Billing Period: <strong id="modalBillPeriod" style="color: var(--text-dark);"></strong></p>
                <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">Amount Due: <strong id="modalBillAmount" style="color: var(--danger); font-size: 1.25rem;"></strong></p>
            </div>
            
            <form asp-action="SubmitBillPayment" method="post" id="paymentForm">
                <input type="hidden" name="id" id="modalBillId" />
                
                <div class="form-group">
                    <label>Payment Method <span class="text-danger">*</span></label>
                    <select name="paymentMethod" class="form-control" required>
                        <option value="">-- Select Payment Method --</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="Easypaisa">Easypaisa</option>
                        <option value="JazzCash">JazzCash</option>
                        <option value="Cash Deposit">Cash Deposit</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Transaction Reference / ID <span class="text-danger">*</span></label>
                    <input type="text" name="transactionReference" class="form-control" required placeholder="E.g. TID-123456789" />
                    <small class="text-muted">Enter the exact transaction reference to help admins verify your payment quickly.</small>
                </div>
                
                <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                    <button type="button" class="btn btn-secondary" onclick="closePaymentModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPaymentModal(billId, amount, period) {
            document.getElementById('modalBillId').value = billId;
            document.getElementById('modalBillAmount').innerText = 'Rs. ' + amount.toLocaleString('en-US');
            document.getElementById('modalBillPeriod').innerText = period;
            document.getElementById('paymentModal').style.display = 'flex';
        }
        
        function closePaymentModal() {
            document.getElementById('paymentModal').style.display = 'none';
            document.getElementById('paymentForm').reset();
        }
    </script>
}
