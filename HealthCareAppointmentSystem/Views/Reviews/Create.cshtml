@model HealthCareAppointmentSystem.Models.Review

@{
    ViewData["Title"] = "Leave a Review";
}

<div class="form-card">
    <h2 style="margin-top: 0;">Review Dr. @ViewBag.DoctorName</h2>
    <p class="text-muted">Your feedback helps us improve our services.</p>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="PatientId" />

        <div class="form-group" style="margin-bottom: 1.5rem;">
            <label asp-for="Rating" class="control-label" style="font-weight: 600; margin-bottom: 0.5rem; display: block;">Rating</label>
            <select asp-for="Rating" class="form-control" style="padding: 0.75rem; border-radius: 6px;">
                <option value="5">5 Stars - Excellent</option>
                <option value="4">4 Stars - Good</option>
                <option value="3">3 Stars - Average</option>
                <option value="2">2 Stars - Poor</option>
                <option value="1">1 Star - Terrible</option>
            </select>
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Comment" class="control-label">Comment (Optional)</label>
            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Share details of your experience..."></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Submit Review</button>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
