@using HealthCareAppointmentSystem.ViewModels
@model IEnumerable<AccountViewModel>

@{
    ViewData["Title"] = "Accounts Management";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 style="margin: 0;">All Accounts</h1>
    <form asp-action="Index" method="get" class="search-form" style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search accounts..." style="max-width: 250px; margin-bottom: 0;" />
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Clear</a>
    </form>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background-color: var(--danger); color: white; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
        @TempData["Error"]
    </div>
}

<div class="detail-card">
    <table class="data-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
        <tbody>
            @foreach (var account in Model)
        {
            <tr>
                <td><span style="color: var(--secondary); font-family: monospace;">#USR-@account.Id.Substring(0, 8)</span></td>
                <td>
                    <div style="font-weight: 600; color: var(--text);">@account.FullName</div>
                </td>    <td>@account.Email</td>
                    <td>
                        @if (string.IsNullOrEmpty(account.Roles))
                        {
                            <span class="status-badge status-pending">No Role</span>
                        }
                        else
                        {
                            <span class="status-badge status-completed">@account.Roles</span>
                        }
                    </td>
                    <td>
                        @if (account.IsBanned)
                        {
                            <span class="status-badge status-cancelled">Banned</span>
                        }
                        else
                        {
                            <span class="status-badge status-completed">Active</span>
                        }
                    </td>
                    <td style="display: flex; gap: 0.5rem;">
                        <form asp-action="ToggleBan" asp-route-id="@account.Id" method="post" onsubmit="return confirm('Are you sure you want to toggle the ban status for this user?');">
                            <button type="submit" class="btn btn-secondary btn-sm">
                                @(account.IsBanned ? "Unban" : "Ban")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@account.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this user? This cannot be undone.');">
                            <button type="submit" class="btn btn-danger btn-sm" style="background-color: var(--danger); border-color: var(--danger);">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
