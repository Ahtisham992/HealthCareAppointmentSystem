@using HealthCareAppointmentSystem.ViewModels
@using Microsoft.AspNetCore.Identity
@using HealthCareAppointmentSystem.Models
@model IEnumerable<AccountViewModel>
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Accounts Management";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    <h1 style="margin: 0;">All Accounts</h1>
    <a asp-action="Create" class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Create Account
    </a>
</div>


<div style="background: var(--card-bg); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid var(--border); padding: 1.5rem; overflow-x: auto;">
    <table id="accountsTable" class="data-table" style="width:100%; margin-top:1rem;">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
        <tbody>
            @foreach (var account in Model)
        {
            <tr>
                <td><span style="color: var(--secondary); font-family: monospace;">#USR-@account.Id.Substring(0, 8)</span></td>
                <td>
                    <div style="font-weight: 600; color: var(--text);">@account.FullName</div>
                </td>    <td>@account.Email</td>
                    <td>
                        @if (string.IsNullOrEmpty(account.Roles))
                        {
                            <span class="status-badge status-pending">No Role</span>
                        }
                        else
                        {
                            <span class="status-badge status-completed">@account.Roles</span>
                        }
                    </td>
                    <td>
                        @if (account.IsBanned)
                        {
                            <span class="status-badge status-cancelled">Banned</span>
                        }
                        else
                        {
                            <span class="status-badge status-completed">Active</span>
                        }
                    </td>
                    <td style="display: flex; gap: 0.5rem;">
                        <a asp-action="Edit" asp-route-id="@account.Id" class="btn-action btn-action-primary">EDIT</a>
                        <a asp-action="Details" asp-route-id="@account.Id" class="btn-action btn-action-secondary">DETAILS</a>
                        
                        @if (UserManager.GetUserId(User) != account.Id)
                        {
                            <form asp-action="ToggleBan" asp-route-id="@account.Id" method="post" onsubmit="return confirm('Are you sure you want to toggle the ban status for this user?');" style="margin:0;">
                                <button type="submit" class="btn-action btn-action-warning">
                                    @(account.IsBanned ? "UNBAN" : "BAN")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@account.Id" method="post" style="display:inline; margin:0;" onsubmit="return confirm('Are you sure you want to permanently delete this user? This cannot be undone.');">
                                <button type="submit" class="btn-action btn-action-danger">DELETE</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#accountsTable').DataTable({
                "pageLength": 10,
                "ordering": true,
                "responsive": true,
                "language": {
                    "search": "Filter:"
                }
            });
        });
    </script>
}
