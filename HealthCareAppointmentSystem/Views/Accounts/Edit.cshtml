@model HealthCareAppointmentSystem.ViewModels.AccountEditViewModel

@{
    ViewData["Title"] = "Edit Account";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="margin: 0;">Edit Account</h1>
    <p style="color: var(--text-muted); margin: 0.5rem 0 0 0;">Update login credentials and full name.</p>
</div>

<div class="form-card" style="max-width: 600px; margin: 0;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem; color: var(--danger);"></div>
        
        <div class="form-group">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" placeholder="Leave blank to keep current password" />
            <span asp-validation-for="NewPassword" class="text-danger" style="color: var(--danger);"></span>
        </div>

        <div class="form-actions" style="margin-top:2rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary" style="flex: 1;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
