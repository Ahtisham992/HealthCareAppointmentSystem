@model HealthCareAppointmentSystem.ViewModels.AccountCreateViewModel
@{
    ViewData["Title"] = "Create User Account";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="margin: 0;">Create User Account</h1>
    <p style="color: var(--text-muted); margin: 0.5rem 0 0 0;">Create a new account and assign a role directly.</p>
</div>

<div class="form-card" style="max-width: 600px; margin: 0;">
    <form method="post" asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: var(--danger); margin-bottom: 1rem;"></div>

        <div class="form-group">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
            <span asp-validation-for="FullName" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="e.g. user@healthcare.local" />
            <span asp-validation-for="Email" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" placeholder="Secure Password" />
            <span asp-validation-for="Password" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Role"></label>
            <select asp-for="Role" class="form-control">
                <option value="">Select a Role...</option>
                <option value="Admin">Admin</option>
                <option value="Receptionist">Receptionist</option>
                <option value="Doctor">Doctor</option>
                <option value="Patient">Patient</option>
            </select>
            <span asp-validation-for="Role" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem;">
                Note: If you select Doctor or Patient, they will be prompted to complete their detailed medical profile upon first login.
            </p>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Create Account</button>
            <a asp-action="Index" class="btn btn-secondary" style="flex: 1;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
