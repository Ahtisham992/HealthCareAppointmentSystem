@using Microsoft.AspNetCore.Identity
@using HealthCareAppointmentSystem.Models
@using HealthCareAppointmentSystem.Data
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthCare Appointment System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">HealthCare System</a>
            <ul class="navbar-links">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    @if (!User.IsInRole("Pharmacist") && !User.IsInRole("Accountant"))
                    {
                        <li><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    }
                    @if (User.IsInRole("Receptionist"))
                    {
                        <li><a asp-controller="Receptionist" asp-action="MyDrawer">Cash Drawer</a></li>
                    }
                    <!-- @if (User.IsInRole("Pharmacist"))
                    {
                        <li><a asp-controller="Pharmacist" asp-action="Index">Pharmacy Dashboard</a></li>
                    } -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                        <li><a asp-controller="Patients" asp-action="Index">Patients</a></li>
                        <li><a asp-controller="Accounts" asp-action="Index">Accounts</a></li>
                        <li><a asp-controller="Wallet" asp-action="Index">Platform Wallet</a></li>
                        <li><a asp-controller="AuditLogs" asp-action="Index">Audit Logs</a></li>
                    }
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Receptionist") && !User.IsInRole("Accountant"))
                    {
                        <li><a asp-controller="Wallet" asp-action="Index">My Wallet</a></li>
                    }
                    <li class="navbar-user">
                        <a asp-controller="Profile" asp-action="Index" style="text-decoration: none; color: var(--primary); font-weight: 600; margin-right: 10px;">
                            Hi, @User.Identity.Name
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="inline-form">
                            <button type="submit" class="link-button">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                }
            </ul>
        </nav>
    </header>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            bool isProfileIncomplete = false;
            if (User.IsInRole("Patient"))
            {
                var patient = await DbContext.Patients.FirstOrDefaultAsync(p => p.ApplicationUserId == user.Id);
                if (patient != null && (patient.DateOfBirth == null || string.IsNullOrWhiteSpace(patient.PhoneNumber)))
                {
                    isProfileIncomplete = true;
                }
            }
            else if (User.IsInRole("Doctor"))
            {
                var doctor = await DbContext.Doctors.FirstOrDefaultAsync(d => d.ApplicationUserId == user.Id);
                if (doctor != null && (doctor.LicenseNumber == "PENDING-UPDATE-REQUIRED" || doctor.ConsultationFee == 0))
                {
                    isProfileIncomplete = true;
                }
            }

            var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            bool isOnProfileEdit = currentController == "Profile" && currentAction == "Edit";

            if (isProfileIncomplete && !isOnProfileEdit)
            {
                <div style="background-color: var(--danger); color: white; text-align: center; padding: 12px; font-weight: 600; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);">
                    <i class="fa-solid fa-triangle-exclamation" style="margin-right: 5px;"></i> 
                    Your profile is incomplete! Please 
                    <a asp-controller="Profile" asp-action="Edit" style="color: white; text-decoration: underline; font-weight: 800;">update your details</a> 
                    to ensure smooth appointments.
                </div>
            }
        }
    }

    <main class="container">
        <!-- Global Toast Notifications -->
        <div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;">
            @if (TempData["Success"] != null)
            {
                <div class="custom-toast toast-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <div class="toast-content">
                        <h4>Success</h4>
                        <p>@TempData["Success"]</p>
                    </div>
                    <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                <div class="custom-toast toast-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div class="toast-content">
                        <h4>Error</h4>
                        <p>@(TempData["Error"] ?? TempData["ErrorMessage"])</p>
                    </div>
                    <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            }
            @if (TempData["Message"] != null)
            {
                <div class="custom-toast toast-info">
                    <i class="fa-solid fa-circle-info"></i>
                    <div class="toast-content">
                        <h4>Notice</h4>
                        <p>@TempData["Message"]</p>
                    </div>
                    <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            }
        </div>

        <style>
            .custom-toast {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 15px 20px;
                border-radius: 8px;
                background: white;
                box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
                min-width: 300px;
                max-width: 400px;
                animation: slideInRight 0.4s ease-out forwards;
                position: relative;
                border-left: 5px solid transparent;
            }
            .toast-success { border-left-color: var(--success); }
            .toast-success i { color: var(--success); font-size: 1.5rem; }
            .toast-error { border-left-color: var(--danger); }
            .toast-error i { color: var(--danger); font-size: 1.5rem; }
            .toast-info { border-left-color: var(--primary); }
            .toast-info i { color: var(--primary); font-size: 1.5rem; }
            
            .toast-content h4 {
                margin: 0 0 4px 0;
                font-size: 1rem;
                color: var(--text-dark);
            }
            .toast-content p {
                margin: 0;
                font-size: 0.9rem;
                color: var(--text-muted);
            }
            .toast-close {
                background: none;
                border: none;
                font-size: 1.5rem;
                color: #94a3b8;
                cursor: pointer;
                margin-left: auto;
                align-self: flex-start;
                line-height: 1;
                padding: 0;
            }
            .toast-close:hover { color: var(--text-dark); }
            
            @@keyframes slideInRight {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @@keyframes fadeOutRight {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
            .toast-hiding {
                animation: fadeOutRight 0.4s ease-in forwards;
            }
        </style>

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toasts = document.querySelectorAll('.custom-toast');
                toasts.forEach(toast => {
                    setTimeout(() => {
                        toast.classList.add('toast-hiding');
                        setTimeout(() => toast.remove(), 400);
                    }, 5000);
                });
            });
        </script>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content footer-grid">
            <div class="footer-column">
                <h3 style="color: var(--primary); font-weight: 800; letter-spacing: -0.5px; margin-top: 0;">HealthCare System</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">Providing world-class medical appointments and AI-driven insights to make preventive care accessible to everyone.</p>
                <div style="font-weight: 600; color: var(--text);">Made by Ahtisham</div>
            </div>
            <div class="footer-column">
                <h4>Quick Links</h4>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="Identity" asp-page="/Account/Login">Login</a>
                <a asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            </div>
            <div class="footer-column">
                <h4>Legal</h4>
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a>
                <a asp-controller="Home" asp-action="Contact">Contact Us</a>
            </div>
            <div class="footer-column">
                <h4>Connect</h4>
                <a href="https://github.com/Ahtisham992/HealthCareAppointmentSystem" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
                    <i class="fa-brands fa-github" style="font-size: 1.5rem; color: #1e293b;"></i> <span style="font-weight: 600;">GitHub</span>
                </a>
            </div>
        </div>
        <div style="text-align: center; border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 2rem; color: var(--text-muted); font-size: 0.9rem;">
            &copy; @DateTime.Now.Year - HealthCare Appointment System. All rights reserved.
        </div>
    </footer>

    <!-- Global Custom Confirm Modal -->
    <div id="custom-confirm-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 12px; width: 100%; max-width: 400px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); overflow: hidden; animation: zoomIn 0.2s ease-out forwards;">
            <div style="padding: 1.5rem; text-align: center;">
                <div style="width: 60px; height: 60px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem; color: var(--danger);"></i>
                </div>
                <h3 style="margin: 0 0 0.5rem 0; color: var(--text-dark);">Are you sure?</h3>
                <p id="custom-confirm-msg" style="margin: 0; color: var(--text-muted); font-size: 0.95rem; line-height: 1.5;"></p>
            </div>
            <div style="background: #f8fafc; padding: 1rem 1.5rem; display: flex; gap: 1rem; justify-content: flex-end; border-top: 1px solid var(--border);">
                <button type="button" class="btn btn-secondary" id="custom-confirm-cancel">Cancel</button>
                <button type="button" class="btn btn-primary" id="custom-confirm-ok" style="background-color: var(--danger); border-color: var(--danger);">Yes, Proceed</button>
            </div>
        </div>
    </div>
    <style>
        @@keyframes zoomIn {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    
    <!-- Global Password Visibility Toggler -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const passwordInputs = document.querySelectorAll('input[type="password"]');
            passwordInputs.forEach(input => {
                const wrapper = document.createElement('div');
                wrapper.style.position = 'relative';
                wrapper.style.display = 'flex';
                wrapper.style.alignItems = 'center';
                
                input.parentNode.insertBefore(wrapper, input);
                wrapper.appendChild(input);
                
                const toggleIcon = document.createElement('i');
                toggleIcon.className = 'fa-solid fa-eye';
                toggleIcon.style.position = 'absolute';
                toggleIcon.style.right = '15px';
                toggleIcon.style.cursor = 'pointer';
                toggleIcon.style.color = 'var(--text-muted)';
                toggleIcon.style.zIndex = '10';
                
                toggleIcon.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (input.type === 'password') {
                        input.type = 'text';
                        toggleIcon.className = 'fa-solid fa-eye-slash';
                    } else {
                        input.type = 'password';
                        toggleIcon.className = 'fa-solid fa-eye';
                    }
                });
                
                wrapper.appendChild(toggleIcon);
                input.style.paddingRight = '45px';
            });

            // Global Table Scroll Wrapper
            // Automatically wrap all non-DataTable tables in a scrollable div to prevent them from taking up too much space
            const tables = document.querySelectorAll('.data-table, .table');
            tables.forEach(table => {
                if (table.id) return;
                
                const parent = table.parentElement;
                if (parent && (parent.style.overflowX === 'auto' || parent.style.overflow === 'hidden')) {
                    parent.style.maxHeight = '400px';
                    parent.style.overflowY = 'auto';
                    parent.style.overflowX = 'auto';
                } else {
                    const wrapper = document.createElement('div');
                    wrapper.style.maxHeight = '400px';
                    wrapper.style.overflowY = 'auto';
                    wrapper.style.overflowX = 'auto';
                    wrapper.style.width = '100%';
                    wrapper.style.borderRadius = '8px';
                    wrapper.style.boxShadow = 'inset 0 -1px 0 0 var(--border)';
                    
                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(table);
                }
            });

            // --- Custom Confirm Modal Interception ---
            
            function showCustomConfirm(msg, onConfirm) {
                const modal = document.getElementById('custom-confirm-modal');
                const msgEl = document.getElementById('custom-confirm-msg');
                const btnOk = document.getElementById('custom-confirm-ok');
                const btnCancel = document.getElementById('custom-confirm-cancel');
                
                msgEl.innerText = msg;
                modal.style.display = 'flex';
                
                // Clone buttons to remove old event listeners
                const newBtnOk = btnOk.cloneNode(true);
                const newBtnCancel = btnCancel.cloneNode(true);
                btnOk.parentNode.replaceChild(newBtnOk, btnOk);
                btnCancel.parentNode.replaceChild(newBtnCancel, btnCancel);
                
                newBtnCancel.addEventListener('click', () => {
                    modal.style.display = 'none';
                });
                
                newBtnOk.addEventListener('click', () => {
                    modal.style.display = 'none';
                    onConfirm();
                });
            }

            // Mutate DOM to replace inline confirms securely
            document.querySelectorAll('form[onsubmit*="return confirm"]').forEach(form => {
                let onsubmitStr = form.getAttribute('onsubmit');
                let match = onsubmitStr.match(/confirm\('([^']+)'\)/);
                let msg = match ? match[1] : "Are you sure you want to proceed?";
                
                // Remove the native confirm immediately so it can never fire
                form.removeAttribute('onsubmit');
                
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    showCustomConfirm(msg, function() {
                        form.submit();
                    });
                });
            });

            document.querySelectorAll('[onclick*="return confirm"]').forEach(btn => {
                let onclickStr = btn.getAttribute('onclick');
                let match = onclickStr.match(/confirm\('([^']+)'\)/);
                let msg = match ? match[1] : "Are you sure you want to proceed?";
                
                // Remove the native confirm immediately so it can never fire
                btn.removeAttribute('onclick');
                
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    showCustomConfirm(msg, function() {
                        if (btn.type === 'submit' && btn.form) {
                            if (btn.name) {
                                const hiddenInput = document.createElement('input');
                                hiddenInput.type = 'hidden';
                                hiddenInput.name = btn.name;
                                hiddenInput.value = btn.value;
                                btn.form.appendChild(hiddenInput);
                            }
                            btn.form.submit();
                        } else if (btn.tagName === 'A' && btn.href) {
                            window.location.href = btn.href;
                        } else {
                            // Fallback for non-submit, non-link buttons (rare in this app)
                            btn.click();
                        }
                    });
                });
            });
            // -----------------------------------------

        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
